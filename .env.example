# Copy to .env (never commit .env). Lines starting with # are optional.

# ---- Database (required) ----
DATABASE_URL=postgres://user:password@localhost:5432/mduka
# DATABASE_URL_UNPOOLED=      # only if your host gives a separate direct URL for migrations
# DATABASE_SSL=true           # set true for hosted databases (Neon, Render, Railway...)

# ---- App ----
PORT=3000
APP_CURRENCY=KES
# NODE_ENV=production         # set on the live site (HTTPS): marks the session cookie Secure
# TRUST_PROXY=true            # only when behind a proxy such as ngrok (production already trusts one hop)
# APP_URL=https://your-app.example.com   # REQUIRED when MAIL_PROVIDER=resend (used in emailed links)
# CSRF_SECRET=                # long random string; set it on the live site
# HEALTH_TOKEN=               # optional: Bearer token that unlocks /health diagnostics

# ---- Email for "forgot password" ----
# "log" prints the reset link in the server console (development only).
MAIL_PROVIDER=log
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM=M-DUKA <no-reply@yourdomain.com>

# ---- Payments ----
PAYMENT_PROVIDER=demo
# PAYMENT_PROVIDER=mpesa      # also needs APP_CURRENCY=KES and a public (non-localhost) callback URL
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-app.example.com/api/webhooks/mpesa/<MPESA_CALLBACK_SECRET>
# MPESA_CALLBACK_SECRET=

# ---- Testing only (scratch database!) ----
# RATE_LIMIT_OFF=true         # lets scripts/stress-test.mjs run fast; never on the live site
# DEMO_ADMIN_PASSWORD=        # 10+ chars; npm run demo:seed creates superadmin@example.com
