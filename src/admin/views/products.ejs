<%- include('partials/header') %>
<%- include('partials/page-tools') %>
<% const badge = { active: 'success', paused: 'warning', removed: 'danger', sold: 'secondary', draft: 'light' }; %>
<form class="row g-2 mb-3" method="get" action="/admin/products">
  <div class="col-md-4"><input class="form-control" name="q" value="<%= f.q %>" placeholder="Search title or seller name"></div>
  <div class="col-md-3">
    <select class="form-select" name="category" aria-label="Category">
      <option value="">All categories</option>
      <% categories.forEach(c => { %><option value="<%= c.category_id %>" <%= f.category === String(c.category_id) ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
  </div>
  <div class="col-md-2">
    <select class="form-select" name="status" aria-label="Status">
      <option value="">Any status</option>
      <% statuses.forEach(s => { %><option value="<%= s %>" <%= f.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
  </div>
  <div class="col-auto"><button class="btn btn-success">Filter</button> <a class="btn btn-outline-secondary" href="/admin/products">Clear</a></div>
  <div class="col text-end">
    <a class="btn btn-outline-success" href="/admin/products/categories"><i class="fa-solid fa-tags"></i> Categories</a>
    <a class="btn btn-success" href="/admin/products/new"><i class="fa-solid fa-plus"></i> Add product</a>
  </div>
</form>

<div class="card"><div class="card-body">
<% if (!rows.length) { %><p class="text-muted mb-0">No products match.</p><% } else { %>
<div class="table-responsive"><table class="table align-middle mb-0">
  <thead><tr><th>Product</th><th>Seller</th><th>Category</th><th class="text-end">Price</th><th class="text-end">Stock</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(p => { %>
    <tr>
      <td><%= p.title %></td>
      <td><%= p.seller %></td>
      <td><%= p.category %></td>
      <td class="text-end"><%= Number(p.asking_price).toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
      <td class="text-end"><%= p.quantity_available %></td>
      <td><span class="badge text-bg-<%= badge[p.listing_status] || 'secondary' %>"><%= p.listing_status %></span></td>
      <td class="text-end"><a class="btn btn-outline-secondary btn-sm" href="/admin/products/<%= p.product_id %>/edit">Manage</a></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% } %>
<%- include('partials/pager') %>
</div></div>
<%- include('partials/footer') %>
