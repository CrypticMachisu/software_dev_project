<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reset password · M-DUKA</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="/admin/static/css/admin.css" rel="stylesheet">
</head>
<body class="login-page">
<div class="login-card">
  <div class="mb-3"><div class="login-brand">M-DUKA</div><div class="text-muted">Reset your password</div></div>
  <% if (done) { %>
    <div class="alert alert-success">Your password has been changed. You have been signed out everywhere.</div>
    <a class="btn btn-success w-100" href="/admin/login">Go to sign in</a>
  <% } else if (invalid) { %>
    <div class="alert alert-danger">This reset link is invalid, expired or has already been used. Ask an administrator for a new one.</div>
  <% } else { %>
    <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
    <form method="post" autocomplete="off">
      <div class="mb-3"><label class="form-label" for="password">New password</label>
        <input class="form-control" id="password" name="password" type="password" required minlength="10" autofocus autocomplete="new-password">
        <div class="form-text">At least 10 characters.</div></div>
      <div class="mb-3"><label class="form-label" for="confirm">Confirm new password</label>
        <input class="form-control" id="confirm" name="confirm" type="password" required minlength="10" autocomplete="new-password"></div>
      <button class="btn btn-success w-100" type="submit">Change password</button>
    </form>
  <% } %>
</div>
</body>
</html>
