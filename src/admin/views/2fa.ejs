<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Two-factor check · M-DUKA</title>
<link href="/admin/static/vendor/bootstrap/5.3.3/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH">
<link href="/fonts/fonts.css" rel="stylesheet">
<link href="/admin/static/css/admin.css" rel="stylesheet">
</head>
<body class="login-page">
<form method="post" action="/admin/2fa" class="login-card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="mb-3"><div class="login-brand">M-DUKA</div><div class="text-muted">Two-factor check</div></div>
  <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
  <p class="small text-muted">Enter the 6-digit code from your authenticator app.</p>
  <div class="mb-3">
    <label class="form-label" for="code">Authentication code</label>
    <input class="form-control form-control-lg text-center" id="code" name="code" inputmode="numeric"
           autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus>
  </div>
  <button class="btn btn-success w-100" type="submit">Verify</button>
  <div class="text-center mt-3 small"><a href="/admin/login">Back to sign in</a></div>
</form>
</body>
</html>
