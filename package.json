{
  "name": "software-dev-project",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "migrate": "node --env-file=.env dist/src/migrate.js",
    "start": "node --env-file=.env dist/src/server.js",
    "dev": "tsc && node --env-file=.env dist/src/server.js",
    "admin:seed": "node --env-file=.env dist/src/scripts/seed-admin.js",
    "demo:seed": "node --env-file=.env dist/src/scripts/seed-demo.js",
    "test:api": "node scripts/regression-test.mjs",
    "test:ui": "node scripts/ui-regression.mjs",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:stress": "node scripts/stress-test.mjs",
    "test:clean": "node scripts/clean-test-accounts.mjs",
    "test": "npm run test:api && npm run test:ui && npm run test:contrast"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "axe-core": "^4.14.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.9.3"
  }
}
