<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= locals.title || 'Admin' %> · M-DUKA Admin</title>
<link href="/admin/static/vendor/bootstrap/5.3.3/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH">

<link href="/fonts/fonts.css" rel="stylesheet">
<link href="/admin/static/css/admin.css" rel="stylesheet">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<%- include('icons') %>
<% const nav = [
  { key: 'dashboard', label: 'Dashboard',        href: '/admin',          icon: 'icon-dashboard', ready: true  },
  { key: 'users',     label: 'Users',            href: '/admin/users',    icon: 'icon-users', ready: true  },
  { key: 'sellers',   label: 'Seller approvals', href: '/admin/users?approval=pending', icon: 'icon-user-check', ready: true  },
  { key: 'products',  label: 'Products',         href: '/admin/products', icon: 'icon-package', ready: true  },
  { key: 'orders',    label: 'Orders',           href: '/admin/orders',   icon: 'icon-receipt', ready: true  },
  { key: 'payouts',   label: 'Payouts',          href: '/admin/payouts',  icon: 'icon-receipt', ready: true  },
  { key: 'exchange',  label: 'Exchange methods', href: '/admin/exchange', icon: 'icon-truck', ready: true,  superOnly: true },
  { key: 'reports',   label: 'Reports',          href: '/admin/reports',  icon: 'icon-chart', ready: true  },
  { key: 'security',  label: 'Security',         href: '/admin/security', icon: 'icon-shield', ready: true  },
  { key: 'help',      label: 'Help',             href: '/admin/help',     icon: 'icon-help',  ready: true  },
  { key: 'audit',     label: 'Audit logs',       href: '/admin/audit',    icon: 'icon-clipboard', ready: true,  superOnly: true },
  { key: 'settings',  label: 'Settings',         href: '/admin/settings', icon: 'icon-gear', ready: false, superOnly: true }
]; %>
<div class="admin-shell d-flex">
  <nav class="admin-sidebar" id="admin-nav" aria-label="Admin sections">
    <div class="sidebar-top">
      <div class="brand">M-DUKA<span class="brand-dot">.</span><small>Admin panel</small></div>
      <button class="nav-toggle" type="button" aria-controls="admin-links" aria-expanded="false" data-nav-toggle><svg class="icon" aria-hidden="true"><use href="#icon-menu"></use></svg><span>Menu</span></button>
    </div>
    <div class="nav-links" id="admin-links">
    <% nav.forEach(n => { if (n.superOnly && !isSuper) return; %>
      <% if (n.ready) { %>
        <a class="nav-item-link <%= active === n.key ? 'active' : '' %>" href="<%= n.href %>"<%- active === n.key ? ' aria-current="page"' : '' %>><svg class="icon" aria-hidden="true"><use href="#<%= n.icon %>"></use></svg> <%= n.label %></a>
      <% } else { %>
        <span class="nav-item-link disabled"><svg class="icon" aria-hidden="true"><use href="#<%= n.icon %>"></use></svg> <%= n.label %> <span class="soon">Soon</span></span>
      <% } %>
    <% }) %>
    <div class="signed-in">Signed in as <%= isSuper ? 'Super admin' : 'Admin' %></div>
    </div>
  </nav>
  <main class="admin-main flex-grow-1" id="main" tabindex="-1">
    <header class="topbar">
      <h1 class="h3 m-0"><%= title %></h1>
      <form method="post" action="/admin/logout" class="topbar-actions m-0">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
        <a class="btn btn-outline-secondary btn-sm" href="/"><svg class="icon" aria-hidden="true"><use href="#icon-store"></use></svg> View store</a>
        <span class="text-muted topbar-name"><%= user.name %></span>
        <button class="btn btn-outline-secondary btn-sm"><svg class="icon" aria-hidden="true"><use href="#icon-logout"></use></svg> Log out</button>
      </form>
    </header>

