<%- include('partials/header') %>
<div class="card" style="max-width: 560px"><div class="card-body">
  <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
  <form method="post" action="/admin/users/new" autocomplete="off">
    <div class="mb-3"><label class="form-label" for="name">Full name</label>
      <input class="form-control" id="name" name="name" value="<%= form.name %>" required maxlength="150"></div>
    <div class="mb-3"><label class="form-label" for="email">Email</label>
      <input class="form-control" id="email" name="email" type="email" value="<%= form.email %>" required maxlength="254"></div>
    <div class="mb-3"><label class="form-label" for="phone">Phone <span class="text-muted">(optional)</span></label>
      <input class="form-control" id="phone" name="phone" value="<%= form.phone %>" maxlength="32"></div>
    <div class="mb-3"><label class="form-label" for="password">Temporary password</label>
      <input class="form-control" id="password" name="password" type="password" required minlength="10" autocomplete="new-password">
      <div class="form-text">At least 10 characters. Share it securely, or create the user and send a reset link instead.</div></div>
    <div class="mb-3"><div class="form-label">Roles</div>
      <% ROLES.forEach(r => { const priv = (r === 'admin' || r === 'super_admin'); if (priv && !canPrivileged) return; %>
        <div class="form-check"><input class="form-check-input" type="checkbox" name="roles" id="role-<%= r %>" value="<%= r %>" <%= form.roles.includes(r) ? 'checked' : '' %>>
        <label class="form-check-label" for="role-<%= r %>"><%= r %></label></div>
      <% }) %>
      <% if (!canPrivileged) { %><div class="form-text">Only a super admin can create admin accounts.</div><% } %>
    </div>
    <div class="d-flex gap-2"><button class="btn btn-success">Create user</button><a class="btn btn-outline-secondary" href="/admin/users">Cancel</a></div>
  </form>
</div></div>
<%- include('partials/footer') %>
