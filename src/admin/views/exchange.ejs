<%- include('partials/header') %>
<%- include('partials/page-tools') %>
<% const badge = { active: 'success', inactive: 'secondary' }; %>
<h2 class="h6">Exchange methods <span class="text-muted fw-normal small">(how a buyer and seller hand over the goods, e.g. courier or pickup)</span></h2>
<div class="card mb-4"><div class="card-body">
  <form class="row g-2 mb-3" method="post" action="/admin/exchange">
    <div class="col-md-3"><input class="form-control" name="name" maxlength="120" placeholder="Name, e.g. In-person pickup" required aria-label="Name"></div>
    <div class="col-md-6"><input class="form-control" name="description" maxlength="1000" placeholder="Description (optional)" aria-label="Description"></div>
    <div class="col-md-3"><button class="btn btn-success w-100"><i class="fa-solid fa-plus"></i> Add method</button></div>
  </form>
  <% if (!methods.length) { %><p class="text-muted mb-0">No exchange methods yet. Sellers cannot complete a sale without one.</p><% } else { %>
  <div class="table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th>Name and description</th><th>Status</th><th class="text-end">Used in</th><th>Managed by</th><th></th></tr></thead>
    <tbody>
    <% methods.forEach(m => { %>
      <tr>
        <td>
          <form id="em-<%= m.exchange_method_id %>" class="row g-2" method="post" action="/admin/exchange/<%= m.exchange_method_id %>/edit">
            <div class="col-md-5"><input class="form-control form-control-sm" name="name" maxlength="120" value="<%= m.name %>" required aria-label="Name"></div>
            <div class="col-md-7"><input class="form-control form-control-sm" name="description" maxlength="1000" value="<%= m.description || '' %>" aria-label="Description"></div>
          </form>
        </td>
        <td><span class="badge text-bg-<%= badge[m.method_status] %>"><%= m.method_status %></span></td>
        <td class="text-end"><%= m.used_by %> orders</td>
        <td><%= m.managed_by %></td>
        <td class="text-end text-nowrap">
          <button class="btn btn-outline-success btn-sm" form="em-<%= m.exchange_method_id %>">Save</button>
          <form class="d-inline" method="post" action="/admin/exchange/<%= m.exchange_method_id %>/toggle" data-confirm="<%= m.method_status === 'active' ? 'Deactivate' : 'Activate' %> '<%= m.name %>'?">
            <button class="btn btn-outline-secondary btn-sm"><%= m.method_status === 'active' ? 'Deactivate' : 'Activate' %></button>
          </form>
          <form class="d-inline" method="post" action="/admin/exchange/<%= m.exchange_method_id %>/delete" data-confirm="Delete '<%= m.name %>'? This cannot be undone.">
            <button class="btn btn-outline-danger btn-sm">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div><% } %>
</div></div>

<h2 class="h6">Payment providers <span class="text-muted fw-normal small">(turn M-Pesa or other providers on and off; keys stay in the server's .env file)</span></h2>
<div class="card"><div class="card-body">
  <form class="row g-2 mb-3" method="post" action="/admin/exchange/providers">
    <div class="col-md-3"><input class="form-control" name="provider_code" maxlength="40" placeholder="Code, e.g. mpesa" required aria-label="Provider code"></div>
    <div class="col-md-6"><input class="form-control" name="display_name" maxlength="120" placeholder="Display name, e.g. M-Pesa" required aria-label="Display name"></div>
    <div class="col-md-3"><button class="btn btn-success w-100"><i class="fa-solid fa-plus"></i> Add provider</button></div>
  </form>
  <% if (!providers.length) { %><p class="text-muted mb-0">No payment providers yet.</p><% } else { %>
  <div class="table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th>Provider</th><th>Code</th><th>Status</th><th class="text-end">Payments</th><th></th></tr></thead>
    <tbody>
    <% providers.forEach(p => { %>
      <tr>
        <td><%= p.display_name %></td><td><code><%= p.provider_code %></code></td>
        <td><span class="badge text-bg-<%= p.provider_status === 'active' ? 'success' : 'secondary' %>"><%= p.provider_status %></span></td>
        <td class="text-end"><%= p.payments %></td>
        <td class="text-end">
          <form class="d-inline" method="post" action="/admin/exchange/providers/<%= p.payment_provider_id %>/toggle" data-confirm="<%= p.provider_status === 'active' ? 'Deactivate' : 'Activate' %> '<%= p.display_name %>'?">
            <button class="btn btn-outline-secondary btn-sm"><%= p.provider_status === 'active' ? 'Deactivate' : 'Activate' %></button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div><% } %>
</div></div>
<%- include('partials/footer') %>
