<%- include('partials/header') %>
<% const badge = { active: 'success', suspended: 'warning', closed: 'secondary' };
   const roleBadge = (r) => r.status === 'approved' ? 'text-bg-success' : r.status === 'pending' ? 'text-bg-warning' : 'text-bg-danger'; %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <form method="get" action="/admin/users" class="row g-2 flex-grow-1 me-3">
    <div class="col-12 col-md-4"><input class="form-control" type="search" name="q" value="<%= filters.q %>" placeholder="Search name, email or phone"></div>
    <div class="col-6 col-md-2"><select class="form-select" name="role" aria-label="Role">
      <option value="">All roles</option>
      <% ROLES.forEach(r => { %><option value="<%= r %>" <%= filters.role === r ? 'selected' : '' %>><%= r %></option><% }) %>
    </select></div>
    <div class="col-6 col-md-2"><select class="form-select" name="status" aria-label="Status">
      <option value="">Any status</option>
      <% ['active','suspended','closed'].forEach(s => { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select></div>
    <div class="col-6 col-md-2"><select class="form-select" name="approval" aria-label="Approval">
      <option value="">Any approval</option>
      <% ['pending','approved','rejected'].forEach(s => { %><option value="<%= s %>" <%= filters.approval === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select></div>
    <div class="col-6 col-md-2 d-flex gap-2">
      <button class="btn btn-success flex-grow-1">Filter</button>
      <a class="btn btn-outline-secondary" href="/admin/users" title="Clear filters">Clear</a>
    </div>
  </form>
  <a class="btn btn-success text-nowrap" href="/admin/users/new"><i class="fa-solid fa-plus"></i> Add user</a>
</div>

<div class="card"><div class="card-body">
  <% if (!users.length) { %>
    <p class="text-muted mb-0">No users match these filters.</p>
  <% } else { %>
  <div class="table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th>Name</th><th>Email</th><th>Roles</th><th>Status</th><th>Joined</th><th></th></tr></thead>
    <tbody>
    <% users.forEach(u => { %>
      <tr>
        <td><a href="/admin/users/<%= u.user_id %>"><%= u.name %></a></td>
        <td><%= u.email %></td>
        <td><% u.roles.forEach(r => { %><span class="badge <%= roleBadge(r) %> me-1"><%= r.role %><%= r.status !== 'approved' ? ' (' + r.status + ')' : '' %></span><% }) %>
            <% if (!u.roles.length) { %><span class="text-muted small">none</span><% } %></td>
        <td><span class="badge text-bg-<%= badge[u.account_status] || 'secondary' %>"><%= u.account_status %></span></td>
        <td class="small text-muted"><%= fmtDate(u.created_at) %></td>
        <td class="text-end"><a class="btn btn-outline-secondary btn-sm" href="/admin/users/<%= u.user_id %>">Manage</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted small"><%= total %> user<%= total === 1 ? '' : 's' %> · page <%= page %> of <%= pages %></span>
    <nav aria-label="Pages"><ul class="pagination pagination-sm mb-0">
      <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="/admin/users?<%= baseQs %>&page=<%= page - 1 %>">Previous</a></li>
      <li class="page-item <%= page >= pages ? 'disabled' : '' %>"><a class="page-link" href="/admin/users?<%= baseQs %>&page=<%= page + 1 %>">Next</a></li>
    </ul></nav>
  </div>
  <% } %>
</div></div>
<%- include('partials/footer') %>
